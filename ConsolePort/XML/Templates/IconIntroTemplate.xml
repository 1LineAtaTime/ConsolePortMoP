<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<Script file="IconIntroTemplate.lua"/>

	<Frame name="CPIconIntroAnimTemplate" virtual="true" alpha="0.5">
		<Animations>
			<!-- 5.4.8: mixin="" and method="" are both Legion era spellings that this
			     client ignores in silence, so CPIconIntroFlyinAnimMixin never reached
			     this group and neither handler was ever hooked. Call the mixin's
			     functions directly instead; an AnimationGroup does not need to carry
			     the methods for two script bodies to use them.
			     <Alpha> also changed: 5.4.8 takes a RELATIVE change="", not the
			     absolute fromAlpha/toAlpha pair, and an unrecognised attribute left
			     change at its default of 0, i.e. these animations did nothing. -->
			<AnimationGroup parentKey="flyin">
				<Alpha change="-1" startDelay="0" duration="0.5" order="1"/>
				<Path parentKey="path" curve="SMOOTH" duration="1" order="1">
					<ControlPoints>
						<ControlPoint offsetX="-117" offsetY="190"/>
						<ControlPoint offsetX="-300" offsetY="260"/>
					</ControlPoints>
				</Path>
				<Alpha parentKey="wait" change="0" duration="0.1" order="2"/>
				<Scripts>
					<OnPlay>
						if CPIconIntroFlyinAnimMixin then
							CPIconIntroFlyinAnimMixin.OnAnimPlay(self);
						end
					</OnPlay>
					<OnFinished>
						if CPIconIntroFlyinAnimMixin then
							CPIconIntroFlyinAnimMixin.OnAnimFinished(self);
						end
					</OnFinished>
				</Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="glow">
				<Alpha 	target="$parentGlow" change="1"	duration="0.3" order="1"/>
				<Alpha 	change="-1" duration="0.3" order="2"/>
				<Scripts>
					<OnPlay>
						local trail = self:GetParent().trail;
						while trail do
							trail:Hide();
							trail = trail.trail;
						end
					</OnPlay>
					<OnFinished>
						self:GetParent():GetParent():Hide();
					</OnFinished>
				</Scripts>
			</AnimationGroup>
		</Animations>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIcon" parentKey="icon" setAllPoints="true" alphaMode="ADD">
				</Texture>
				<Texture name="$parentBG" parentKey="bg" setAllPoints="true">
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentGlow" parentKey="iconGlow" file="Interface\SpellActivationOverlay\IconAlert" alpha="0" setAllPoints="true" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" x="-10" y="10"/>
						<Anchor point="BOTTOMRIGHT"  x="10" y="-10"/>
					</Anchors>
					<TexCoords left="0.00781250" right="0.50781250" top="0.53515625" bottom="0.78515625"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>


	<Frame name="CPIconIntroTemplate" virtual="true" frameStrata="HIGH" mixin="CPIconIntroMixin">
		<Size>
			<AbsDimension x="40" y="40"/>
		</Size>
		<Frames>
			<Frame name="$parentIconTrail3" inherits="CPIconIntroAnimTemplate" parentKey="trail3" >
				<Size>
					<AbsDimension x="10" y="10"/>
				</Size>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame name="$parentIconTrail2" inherits="CPIconIntroAnimTemplate" parentKey="trail2" >
				<Size>
					<AbsDimension x="20" y="20"/>
				</Size>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame name="$parentIconTrail1" inherits="CPIconIntroAnimTemplate" parentKey="trail1" >
				<Size>
					<AbsDimension x="30" y="30"/>
				</Size>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
			</Frame>
			<Frame name="$parentIcon" inherits="CPIconIntroAnimTemplate" parentKey="icon" >
				<Size>
					<AbsDimension x="40" y="40"/>
				</Size>
				<Anchors>
					<Anchor point="CENTER" x="0" y="0"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				-- 5.4.8: mixin="CPIconIntroMixin" on the frame above is ignored by this
				-- client's XML parser, so AnimateNewActionFromCoords and
				-- CalculatePathOffset were missing and the spell-push animation could
				-- not be driven at all. Apply the mixin here, gaps only.
				if type(CPIconIntroMixin) == 'table' then
					for k, v in pairs(CPIconIntroMixin) do
						if self[k] == nil then self[k] = v end
					end
				end

				self.paths = {};

				for _, child in pairs({self:GetChildren()}) do
					self.paths[child.flyin.path] = true;
				end

				self.icon.isBase = true;
				self.icon:SetAlpha(1.0);
				self.trail1.flyin.wait:SetDuration(0.16 * 0.9);
				self.trail2.flyin.wait:SetDuration(0.21 * 0.9);
				self.trail3.flyin.wait:SetDuration(0.255 * 0.9);

				self.glow = self.icon.iconGlow;
				self.icon.trail = self.trail1;
				self.trail1.trail = self.trail2;
				self.trail2.trail = self.trail3;
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>
